<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- El entrenamiento en curso muestra una notificación fija; Android 13+ pide permiso. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lectura de la actividad del día desde Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <application
        android:name=".SiezaGymApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiezaGym">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.SiezaGym">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Health Connect abre esta pantalla para explicar por qué la app pide leer la actividad.
            En Android 13 y menos, además, Ajustes la usa para mostrar el uso del permiso.
        -->
        <activity
            android:name=".Features.Shared.PrivacyPolicyActivity"
            android:exported="true"
            android:theme="@style/Theme.SiezaGym">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".Features.Shared.PrivacyPolicyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- El widget "Hoy": la app le deja el resumen y Glance lo dibuja. -->
        <receiver
            android:name=".Widget.SiezaWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_hoy_etiqueta">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sieza_widget_info" />
        </receiver>
    </application>

</manifest>